# The version of the Boost header tree P2_BOOST_ROOT names (BoostConfig.cmake beside this file), from
# BOOST_VERSION in boost/version.hpp: 109200 is 1.92.0.
set(PACKAGE_VERSION "0.0.0")
if(EXISTS "${P2_BOOST_ROOT}/boost/version.hpp")
    file(STRINGS "${P2_BOOST_ROOT}/boost/version.hpp" _p2_bv REGEX "^#define BOOST_VERSION [0-9]+$")
    string(REGEX REPLACE "^#define BOOST_VERSION ([0-9]+)$" "\\1" _p2_bv "${_p2_bv}")
    if(_p2_bv MATCHES "^[0-9]+$")
        math(EXPR _p2_major "${_p2_bv} / 100000")
        math(EXPR _p2_minor "${_p2_bv} / 100 % 1000")
        math(EXPR _p2_patch "${_p2_bv} % 100")
        set(PACKAGE_VERSION "${_p2_major}.${_p2_minor}.${_p2_patch}")
    endif()
endif()
set(PACKAGE_VERSION_COMPATIBLE FALSE)
set(PACKAGE_VERSION_EXACT FALSE)
if(PACKAGE_VERSION VERSION_EQUAL PACKAGE_FIND_VERSION)
    set(PACKAGE_VERSION_COMPATIBLE TRUE)
    set(PACKAGE_VERSION_EXACT TRUE)
endif()
